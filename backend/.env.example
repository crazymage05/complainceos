MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=complianceos
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_PROJECT=vertical-idea-470614-j5
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=./gcloud-key.json
PROJECT_PHASE=1
OLLAMA_MODEL=llama3
AGENT_MODEL=gemini-2.5-flash

# ── Hardening (optional) ───────────────────────────────────────────────────────
# Comma-separated CORS allow-list. Use "*" only in dev. In prod, list the Vercel
# preview URL + production URL.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Toggle to "true" once GOOGLE_APPLICATION_CREDENTIALS points at a Firebase
# service-account JSON; every /api/v1 route then requires a valid ID token.
REQUIRE_AUTH=false
FIREBASE_PROJECT_ID=
# Per-IP rate limit on Gemini-backed endpoints.
GEMINI_RPM=10
LOG_LEVEL=INFO
